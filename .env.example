# Local development. Copy to .env (git-ignored).
APP_ENV=development
ADDR=:8080
BASE_URL=http://localhost:8080
STATIC_DIR=web/dist
# DATABASE_URL=postgres://pomosky:pomosky@localhost:5432/pomosky?sslmode=disable
# SESSION_SECRET=

# Optional login. Without DATABASE_URL login is off. In development sign-in links are
# written to the server log; set SMTP_* (and MAIL_FROM) to really send them.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=   # redirect URI: BASE_URL + /auth/google/callback
# MAIL_FROM=Pomosky <no-reply@example.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# HOST_TOKEN_SALT=
# OPEN_METEO_BASE=https://api.open-meteo.com
# WEATHER_CACHE_TTL=10m

# Auto-reload for local development (templates from disk + browser refresh).
# make dev sets this for you. Never enable it in production.
# DEV_RELOAD=true
# DEV_VIEWS_DIR=internal/views

# Set to true only behind a proxy you control (Caddy); enables X-Forwarded-For for rate limits.
# TRUST_PROXY=false
