# ============================================================================
# Pomosky: local development settings.
#   cp .env.example .env     (.env is git-ignored; the server reads it on start)
# A variable that is already set in your shell wins over this file.
# Every variable is explained in docs/env.md. Production uses deploy/.env.example.
# ============================================================================

# ---- Basics -----------------------------------------------------------------
APP_ENV=development
ADDR=:8080
BASE_URL=http://localhost:8080
STATIC_DIR=web/dist

# ---- Development helpers ----------------------------------------------------
# `make dev` turns these on for you. Never enable DEV_RELOAD in production.
# DEV_RELOAD=true
# DEV_VIEWS_DIR=internal/views

# ---- Database (optional) ----------------------------------------------------
# Without it the server still runs: anonymous rooms, timer, reactions and weather work.
# With it you also get login, saved rooms and monthly statistics.
# DATABASE_URL=postgres://pomosky:pomosky@localhost:5432/pomosky?sslmode=disable

# ---- Admin page (/admin) ----------------------------------------------------
# Emails of the operators; log in with one of them to open /admin.
# ADMIN_EMAILS=you@example.com
# ADMIN_HOST=dash.example.com
# COOKIE_DOMAIN=.example.com

# ---- Rooms ------------------------------------------------------------------
# HOST_TOKEN_SALT=any-long-random-text
# ROOM_IDLE_TTL=10m

# ---- Login (needs DATABASE_URL) ---------------------------------------------
# In development, sign-in links for the email login are printed in the server log.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# MAIL_FROM=Pomosky <no-reply@example.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# ---- Weather (Open-Meteo) ---------------------------------------------------
# The defaults are the public free API. See docs/env.md about its terms.
# OPEN_METEO_BASE=https://api.open-meteo.com
# OPEN_METEO_GEOCODING_BASE=https://geocoding-api.open-meteo.com
# WEATHER_CACHE_TTL=10m

# ---- Behind a proxy ---------------------------------------------------------
# Only when every request comes through a proxy you control (Caddy).
# TRUST_PROXY=false
