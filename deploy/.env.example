# ============================================================================
# Pomosky: production settings for docker compose.
#   ./scripts/init-env.sh     creates deploy/.env with fresh random secrets
# or copy this file to deploy/.env by hand. deploy/.env is git-ignored: never
# commit it, never paste it in chats. Every variable: docs/env.md
# ============================================================================

# ---- Required ---------------------------------------------------------------
DOMAIN=pomosky.example.com
BASE_URL=https://pomosky.example.com
POSTGRES_PASSWORD=change-me
HOST_TOKEN_SALT=change-me-long-random

# ---- Fixed for production ---------------------------------------------------
APP_ENV=production
TRUST_PROXY=true

# ---- Rooms and weather (defaults are fine) ----------------------------------
ROOM_IDLE_TTL=10m
WEATHER_CACHE_TTL=10m

# ---- Login (optional; pick one or both) --------------------------------------
# Google: redirect URI to register is  BASE_URL/auth/google/callback
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# Email links:
# MAIL_FROM=Pomosky <no-reply@example.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# DEV_RELOAD is for local development only: the server refuses to start with it in production.
