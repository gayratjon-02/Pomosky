# Copy to deploy/.env (git-ignored) and fill in. Never commit real values.
DOMAIN=pomosky.example.com
POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me-long-random
HOST_TOKEN_SALT=change-me-long-random
BASE_URL=https://pomosky.example.com
APP_ENV=production
WEATHER_CACHE_TTL=10m
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# Login needs at least one of: Google (redirect URI = BASE_URL/auth/google/callback) or SMTP for email links.
# MAIL_FROM=Pomosky <no-reply@example.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# ROOM_IDLE_TTL=10m

# DEV_RELOAD is for local development only; the server refuses to start with it in production.
TRUST_PROXY=true
