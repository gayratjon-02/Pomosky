{$DOMAIN} {
	encode zstd gzip

	# Cache headers of /static/* come from the app: hashed files are "immutable" for a year,
	# the rest is revalidated. Do not set Cache-Control here, it would override them.

	# WebSocket upgrades are handled automatically by reverse_proxy.
	reverse_proxy app:8080 {
		header_up X-Real-IP {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
